{
    "_Note 1_": "The following is the set up for the dataset",
    
    "dataset_path": "datasets/eval_datasets",
    "dataset_name": "pems03",
    "dataset_type": "st_graph",
    "train_val_test_ratio": [0.6, 0.2, 0.2],
    "past_steps": 96,
    "future_steps": 96,
    "stride": 1,
    "few_shot_ratio": 1.0,


    "_Note 2_": "The following is the set up for the task",
    
    "task_name": "long_forecasting",
    "batch_size": 128,
    "epochs": 100,
    "metric_name": ["masked_mae", "masked_rmse", "masked_mape"],

    
    "_Note 3_": "The following is the set up for the method",

    "model_type": "expert",
    "model_name": "STNorm",
    "node_num": 358,
    "tnorm_bool": true,
    "snorm_bool": true,
    "in_channel_dim": 3,
    "out_channel_dim": 32,
    "kernel_size": 3,
    "blocks": 4,
    "layers": 2,
    "output_dim": 96,

    "optimizer_name": "Adam",
    "learning_rate": 1e-3,
    "weight_decay": 1e-4,
    "clip_grad_value": 5.0,

    "scheduler_name": "None",

    "criterion_name": "masked_mae"

}
